{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run FastAPI Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "2. Run Flutter Passenger App (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/passenger_app",
      "args": ["-d", "chrome"]
    }
  ]
}
