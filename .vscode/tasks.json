{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FastAPI Backend",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Officer Dashboard (React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/officer-dashboard"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Passenger App (Flutter Web)",
      "type": "shell",
      "command": "flutter run -d chrome",
      "options": {
        "cwd": "${workspaceFolder}/passenger_app"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
